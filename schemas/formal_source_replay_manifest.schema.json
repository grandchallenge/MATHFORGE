{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/formal_source_replay_manifest.schema.json",
  "title": "MATHFORGE external formal-source replay manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "upstream_repository",
    "upstream_commit",
    "lean_toolchain",
    "mathlib_revision",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "upstream_repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "upstream_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "lean_toolchain": {
      "type": "string",
      "minLength": 3
    },
    "mathlib_revision": {
      "type": "string",
      "minLength": 3
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "byte_length",
          "sha256",
          "problem_count",
          "statement_count"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^replay/.+\\.json$"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "problem_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "statement_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    }
  }
}
