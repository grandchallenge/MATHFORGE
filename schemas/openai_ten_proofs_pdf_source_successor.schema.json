{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/openai_ten_proofs_pdf_source_successor.schema.json",
  "title": "OpenAI Ten Proofs current PDF source successor",
  "type": "object",
