{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/mathforge-algebraic-witness-registry.schema.json",
  "title": "MATHFORGE Algebraic Witness Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "witnesses"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"const": "MF-ALGEBRAIC-WITNESS-REGISTRY"},
    "witnesses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["witness_id", "path", "git_blob_sha1", "schema_path", "execution_status", "trust_status"],
        "properties": {
          "witness_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^examples/algebraic_witnesses/.+\\.json$"},
          "git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "schema_path": {"const": "schemas/algebraic_witness.schema.json"},
          "execution_status": {"enum": ["not_run", "completed", "failed", "timed_out", "budget_exhausted"]},
          "trust_status": {"enum": ["external_output_only", "external_witness_recorded", "script_replayed", "ready_for_mathcert", "blocked"]}
        }
      }
    }
  }
}
