{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/provider_coverage.schema.json",
  "title": "MATHFORGE Provider Coverage Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "reviewed_at", "active_campaigns"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "audit_id": {"const": "MF-GOV-WP00"},
    "reviewed_at": {"type": "string", "format": "date"},
    "active_campaigns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["campaign_id", "title", "disposition"],
        "properties": {
          "campaign_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
          "title": {"type": "string", "minLength": 3},
          "disposition": {"enum": ["manifest", "waiver"]},
          "manifest_path": {"type": "string"},
          "waiver": {
            "type": "object",
            "additionalProperties": false,
            "required": ["approved_by", "reason", "scope", "review_on"],
            "properties": {
              "approved_by": {"type": "string", "minLength": 2},
              "reason": {"type": "string", "minLength": 10},
              "scope": {"type": "string", "minLength": 3},
              "review_on": {"type": "string", "format": "date"}
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"disposition": {"const": "manifest"}}}, "then": {"required": ["manifest_path"], "not": {"required": ["waiver"]}}},
          {"if": {"properties": {"disposition": {"const": "waiver"}}}, "then": {"required": ["waiver"], "not": {"required": ["manifest_path"]}}}
        ]
      }
    }
  }
}
