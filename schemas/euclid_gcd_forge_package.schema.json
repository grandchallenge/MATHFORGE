{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EUCLID-GCD-E2E-001 MATHFORGE package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "campaign_id",
    "stage",
    "authority_state",
    "governing_authorization",
    "problem_card",
    "source_map",
    "status_triage",
    "reconnaissance_ledger",
    "failure_risks",
    "suggested_wp01",
    "certification_route_sketch",
    "solve_handoff",
    "chaidez_documentary_contract",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "package_id": {"const": "MF-EUCLID-GCD-E2E-001-WP00"},
    "campaign_id": {"const": "EUCLID-GCD-E2E-001"},
    "stage": {"const": "FORGE_INTAKE_AND_HANDOFF"},
    "authority_state": {"const": "candidate_provider_handoff"},
    "governing_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["programme_repository", "programme_protected_head", "programme_issue", "forge_issue"],
      "properties": {
        "programme_repository": {"const": "grandchallenge/MATH-PROGRAMME"},
        "programme_protected_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "programme_issue": {"const": 237},
        "forge_issue": {"const": 63}
      }
    },
    "problem_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "domain", "normalized_statement", "quantifiers", "input_contract", "object_certificate_separation"],
      "properties": {
        "title": {"type": "string", "minLength": 10},
        "domain": {"const": "elementary_number_theory"},
        "normalized_statement": {"type": "string", "minLength": 100},
        "quantifiers": {"type": "object"},
        "input_contract": {"type": "object"},
        "object_certificate_separation": {"type": "object"}
      }
    },
    "source_map": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "status_triage": {"type": "object"},
    "reconnaissance_ledger": {"type": "object"},
    "failure_risks": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk_id", "summary", "required_rejection"],
        "properties": {
          "risk_id": {"type": "string", "pattern": "^EGR-[0-9]{3}$"},
          "summary": {"type": "string", "minLength": 20},
          "required_rejection": {"type": "string", "minLength": 10}
        }
      }
    },
    "suggested_wp01": {"type": "object"},
    "certification_route_sketch": {"type": "object"},
    "solve_handoff": {"type": "object"},
    "chaidez_documentary_contract": {"type": "object"},
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certifies_mathematics", "certifies_candidate_witness", "claims_novelty", "claims_priority", "claims_historical_verbatim_equivalence", "statement"],
      "properties": {
        "certifies_mathematics": {"const": false},
        "certifies_candidate_witness": {"const": false},
        "claims_novelty": {"const": false},
        "claims_priority": {"const": false},
        "claims_historical_verbatim_equivalence": {"const": false},
        "statement": {"type": "string", "minLength": 80}
      }
    }
  }
}
