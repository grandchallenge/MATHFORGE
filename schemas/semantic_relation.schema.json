{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/semantic_relation.schema.json",
  "title": "Typed semantic catalog relation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "relation_id", "subject_id", "predicate", "object_id", "review_state", "proposer", "evidence"],
  "properties": {
    "schema_version": {"const": "2.0.0"}, "relation_id": {"type": "string", "pattern": "^GCL-REL-[A-Z0-9-]+$"},
    "subject_id": {"type": "string", "minLength": 3}, "predicate": {"enum": ["same_statement", "formalizes", "specializes", "generalizes", "implies", "related", "duplicate_candidate", "conflicts", "rejected_match"]},
    "object_id": {"type": "string", "minLength": 3}, "review_state": {"enum": ["AUTOMATED_PROPOSAL", "HUMAN_REVIEWED", "REJECTED"]},
    "proposer": {"type": "string", "minLength": 2}, "reviewer": {"type": "string", "minLength": 2}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
