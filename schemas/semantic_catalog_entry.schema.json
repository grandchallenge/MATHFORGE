{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/semantic_catalog_entry.schema.json",
  "title": "GCL semantic catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "provider_id", "snapshot_id", "source", "statement_kind", "representations", "classification", "status_assertions", "proof_annotations", "licensing", "assurance", "relation_ids", "unresolved_ambiguities", "excluded_inferences", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "catalog_id": {"type": "string", "pattern": "^GCL-CAT-[A-Z0-9-]+$"},
    "provider_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
    "snapshot_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["locator", "url", "raw_sha256"],
      "properties": {"locator": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri"}, "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "statement_kind": {"enum": ["problem", "conjecture", "theorem", "definition", "formal_declaration", "other"]},
    "representations": {
      "type": "object", "additionalProperties": false, "required": ["original", "normalized", "normalization_method"],
      "properties": {"original": {"type": "string", "minLength": 1}, "normalized": {"type": "string", "minLength": 1}, "normalization_method": {"type": "string", "minLength": 3}}
    },
    "formal_language": {
      "type": "object", "additionalProperties": false, "required": ["language", "toolchain", "declaration_name", "source_path"],
      "properties": {"language": {"type": "string", "minLength": 1}, "toolchain": {"type": "string", "minLength": 1}, "declaration_name": {"type": "string", "minLength": 1}, "source_path": {"type": "string", "minLength": 1}}
    },
    "classification": {
      "type": "object", "additionalProperties": false, "required": ["msc2020_primary", "mapping_method", "facets"],
      "properties": {"msc2020_primary": {"type": ["string", "null"], "pattern": "^[0-9]{2}[A-Z-][0-9X]{2}$"}, "mapping_method": {"type": "string", "minLength": 3}, "facets": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}
    },
    "status_assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
    "proof_annotations": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
    "licensing": {
      "type": "object", "additionalProperties": false, "required": ["license", "redistribution_class"],
      "properties": {"license": {"type": "string", "minLength": 2}, "redistribution_class": {"enum": ["full_text", "metadata_only", "internal_review"]}}
    },
    "assurance": {
      "type": "object", "additionalProperties": false, "required": ["tier", "evidence"],
      "properties": {"tier": {"enum": ["SOURCE_LOCKED", "NORMALIZED_REPLAYED", "SEMANTICALLY_REVIEWED", "CAMPAIGN_CONCORDANT"]}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "reviewer": {"type": "string", "minLength": 2}}
    },
    "relation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^GCL-REL-[A-Z0-9-]+$"}},
    "unresolved_ambiguities": {"type": "array", "items": {"type": "string"}},
    "excluded_inferences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["programme_status", "semantic_equivalence", "proof", "novelty", "campaign_authority", "certification"]}},
    "claim_boundary": {"type": "string", "minLength": 80}
  },
  "$defs": {
    "assertion": {
      "type": "object", "additionalProperties": false, "required": ["issuer", "value", "source_locator", "authority"],
      "properties": {"issuer": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}, "source_locator": {"type": "string", "minLength": 1}, "authority": {"enum": ["source_attributed", "gcl_reviewed"]}}
    }
  }
}
