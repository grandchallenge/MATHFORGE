{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/vgse_retrospective_review_attestation.schema.json",
  "title": "MATHFORGE VGSE Retrospective Review Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "campaign_id",
    "subject",
    "historical_finding",
    "remedy_contract",
    "activation",
    "gate_effect",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"const": "MF-VGSE-REVIEW-REMEDY-001"},
    "campaign_id": {"const": "VGSE-001"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pull_request", "head_sha", "merge_commit_sha", "original_author"],
      "properties": {
        "repository": {"const": "grandchallenge/MATHFORGE"},
        "pull_request": {"const": 33},
        "head_sha": {"const": "c42a663e67a6d8a57f8637e89e3f323226b152d9"},
        "merge_commit_sha": {"const": "6f79cbca52992bf03ad025347f7416e4e8fa895c"},
        "original_author": {"const": "fyremael"}
      }
    },
    "historical_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submitted_review_count", "review_gate_satisfied_at_merge", "history_may_be_rewritten"],
      "properties": {
        "submitted_review_count": {"const": 0},
        "review_gate_satisfied_at_merge": {"const": false},
        "history_may_be_rewritten": {"const": false}
      }
    },
    "remedy_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracker_issue",
        "attestation_pull_request",
        "required_event",
        "reviewer_must_differ_from_original_author",
        "reviewer_role",
        "conversation_comment_is_sufficient",
        "reaction_is_sufficient",
        "merge_action_is_sufficient",
        "reapproval_required_after_head_change",
        "required_review_assertions"
      ],
      "properties": {
        "tracker_issue": {"const": 42},
        "attestation_pull_request": {"type": ["integer", "null"], "minimum": 1},
        "required_event": {"const": "APPROVED"},
        "reviewer_must_differ_from_original_author": {"const": true},
        "reviewer_role": {"const": "MATHFORGE maintainer"},
        "conversation_comment_is_sufficient": {"const": false},
        "reaction_is_sufficient": {"const": false},
        "merge_action_is_sufficient": {"const": false},
        "reapproval_required_after_head_change": {"const": true},
        "required_review_assertions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "reviewer_independence",
              "exact_subject_identity_reviewed",
              "vgse_source_identity_and_normalization_accepted",
              "source_reconstruction_and_candidate_boundaries_accepted",
              "retrospective_nature_and_no_claim_promotion_acknowledged"
            ]
          }
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "condition", "effect_is_retroactive"],
      "properties": {
        "state": {"const": "proposed_until_non_author_approval_and_protected_merge"},
        "condition": {"const": "attestation PR receives a non-author maintainer APPROVED review on its final exact head and is then protected-merged"},
        "effect_is_retroactive": {"const": false}
      }
    },
    "gate_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_governance_after_activation",
        "programme_candidate_state",
        "may_admit_campaign",
        "may_adjudicate_in_mathcert",
        "may_promote_mechanical_or_commercial_claims"
      ],
      "properties": {
        "independent_governance_after_activation": {"const": "prospectively_remediated_by_retrospective_attestation"},
        "programme_candidate_state": {"const": "pre_admission_candidate"},
        "may_admit_campaign": {"const": false},
        "may_adjudicate_in_mathcert": {"const": false},
        "may_promote_mechanical_or_commercial_claims": {"const": false}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 120}
  }
}
