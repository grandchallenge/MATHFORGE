{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/external_source_registry.schema.json",
  "title": "MATHFORGE External Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "sources"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"const": "MF-EXTERNAL-SOURCES"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_class", "upstream", "immutable_revision", "record_path", "reliability_path", "claim_boundary"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
          "source_class": {"enum": ["corpus_row", "formal_statement_repository"]},
          "upstream": {"type": "string", "minLength": 3},
          "immutable_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "record_path": {"type": "string", "minLength": 3},
          "reliability_path": {"type": "string", "minLength": 3},
          "claim_boundary": {"type": "string", "minLength": 80}
        }
      }
    }
  }
}
