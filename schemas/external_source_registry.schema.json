{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.ai/schemas/external_source_registry.schema.json",
  "title": "MATHFORGE External Provider Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "providers", "authority_boundary"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "registry_id": {"const": "MF-EXTERNAL-SOURCES"},
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider_id", "legacy_source_ids", "source_class", "upstream", "admitted_snapshot", "observatory", "adapter", "refresh_policy", "licensing", "visibility", "reliability_limitations", "claim_boundary"],
        "properties": {
          "provider_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
          "legacy_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"}},
          "source_class": {"enum": ["mathematical_corpus", "formal_statement_repository"]},
          "upstream": {
            "type": "object", "additionalProperties": false, "required": ["locator", "url"],
            "properties": {"locator": {"type": "string", "minLength": 3}, "url": {"type": "string", "format": "uri"}}
          },
          "admitted_snapshot": {
            "type": "object", "additionalProperties": false, "required": ["snapshot_id", "revision", "manifest_path"],
            "properties": {
              "snapshot_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
              "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "manifest_path": {"type": "string", "minLength": 3}
            }
          },
          "observatory": {
            "type": "object", "additionalProperties": false, "required": ["observed_revision", "observed_at", "admission_state"],
            "properties": {
              "observed_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "observed_at": {"type": "string", "format": "date-time"},
              "admission_state": {"enum": ["ADMITTED_CURRENT", "UPSTREAM_AHEAD", "UPSTREAM_UNAVAILABLE"]}
            }
          },
          "adapter": {
            "type": "object", "additionalProperties": false, "required": ["path", "version", "replay_command"],
            "properties": {
              "path": {"type": "string", "minLength": 3}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
              "replay_command": {"type": "string", "minLength": 10}
            }
          },
          "refresh_policy": {
            "type": "object", "additionalProperties": false, "required": ["observation_schedule", "admission_schedule", "event_triggers", "automatic_admission"],
            "properties": {
              "observation_schedule": {"const": "weekly"}, "admission_schedule": {"const": "monthly"},
              "event_triggers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["corrected_misformalization", "licensing_change", "campaign_change", "security_concern"]}},
              "automatic_admission": {"const": false}
            }
          },
          "licensing": {
            "type": "object", "additionalProperties": false, "required": ["software", "content", "third_party", "disposition"],
            "properties": {
              "software": {"type": "string", "minLength": 2}, "content": {"type": "string", "minLength": 2},
              "third_party": {"type": "string", "minLength": 2}, "disposition": {"enum": ["full_text", "metadata_only", "internal_review"]}
            }
          },
          "visibility": {"enum": ["public_full_text", "public_metadata_only", "internal_review"]},
          "reliability_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 20}},
          "claim_boundary": {"type": "string", "minLength": 80}
        }
      }
    },
    "authority_boundary": {"type": "string", "minLength": 100}
  }
}
