import Mathlib.NumberTheory.NumberField.HeckeLFunction
import Mathlib.GroupTheory.QuotientGroup.Basic
import Mathlib.RingTheory.DedekindDomain.Factorization
import Mathlib.Topology.Algebra.Group.Subgroup
import Mathlib.Topology.Algebra.Group.Units
import Mathlib.Topology.Algebra.Group.Quotient

/-!
# F003 global idèle class group: the unramified-outside local-unit quotient

Separately locked native mathlib: 6e96f3e25b9b23468a6f155342b5a1e5e33ac8f9,
Lean v4.36.0-rc2.

This file uses actual NumberField.IdeleClassGroup R K and actual local
integer-unit groups. It constructs the global subgroup generated by
images of local unit groups outside a prescribed bad set and proves that
the native Hecke character descends through the global quotient if and
only if it is unramified at each good finite place.

This is not the *full* ray class group: at primes dividing the modulus,
deep principal-unit subgroups, and at infinity the archimedean subgroup,
must also be quotiented out; the resulting quotient must then be shown
equivalent to the classical ideal ray-class group with orientation fixed.
No global equivalence or meromorphic continuation is claimed.
-/

namespace GCL.OAI26.F003.NativeRaySkeleton

open NumberField
open IsDedekindDomain

noncomputable section

variable {R K : Type*} [CommRing R] [IsDedekindDomain R]
  [Field K] [Algebra R K] [IsFractionRing R K]

/-- Genuine local integer units mapped into the native idèle class group. -/
def localUnitImage (v : HeightOneSpectrum R) :
    (v.adicCompletionIntegers K)ˣ →* NumberField.IdeleClassGroup R K :=
  (NumberField.IdeleClassGroup.ofAdicCompletion R K v).comp
    (Units.map (v.adicCompletionIntegers K).subtype.toMonoidHom)

/-- Character restriction to a good local unit group as a group homomorphism. -/
def restrictedUnitCharacter
    (χ : NumberField.HeckeCharacter R K) (v : HeightOneSpectrum R) :
    (v.adicCompletionIntegers K)ˣ →* ℂˣ :=
  (χ.toMonoidHom.toHomUnits).comp (localUnitImage (R := R) (K := K) v)

/-- Native local unramifiedness is exactly vanishing of the global
idèle class character on the corresponding local-unit subgroup. -/
theorem isUnramifiedAt_iff_restrictedUnitCharacter_one
    (χ : NumberField.HeckeCharacter R K) (v : HeightOneSpectrum R) :
    χ.IsUnramifiedAt v ↔
      restrictedUnitCharacter χ v = 1 := by
  have h : (χ.restrict v).toUnitHom.comp
      (Units.map (v.adicCompletionIntegers K).subtype.toMonoidHom) =
        restrictedUnitCharacter χ v := by
    apply MonoidHom.ext
    intro u
    apply Units.ext
    simp [restrictedUnitCharacter, localUnitImage,
      NumberField.HeckeCharacter.restrict, MulChar.ofUnitHom_coe]
  exact h ▸ Iff.rfl

theorem isUnramifiedAt_iff_range_le_ker
    (χ : NumberField.HeckeCharacter R K) (v : HeightOneSpectrum R) :
    χ.IsUnramifiedAt v ↔
      (localUnitImage (R := R) (K := K) v).range ≤
        χ.toMonoidHom.toHomUnits.ker := by
  rw [isUnramifiedAt_iff_restrictedUnitCharacter_one]
  constructor
  · intro h x hx
    obtain ⟨u, rfl⟩ := hx
    rw [MonoidHom.mem_ker]
    have h₁ := congrArg (fun f : (v.adicCompletionIntegers K)ˣ →* ℂˣ => f u) h
    simpa [restrictedUnitCharacter] using h₁
  · intro h
    apply MonoidHom.ext
    intro u
    rw [MonoidHom.one_apply]
    have hu : localUnitImage (R := R) (K := K) v u ∈
        χ.toMonoidHom.toHomUnits.ker :=
      h ⟨u, rfl⟩
    exact (MonoidHom.mem_ker).mp hu

/-- The globally generated subgroup of local units outside the
selected bad places (e.g. primes dividing a ray modulus). -/
def outsideUnitSubgroup
    (bad : Set (HeightOneSpectrum R)) :
    Subgroup (NumberField.IdeleClassGroup R K) :=
  ⨆ v : {v : HeightOneSpectrum R // v ∉ bad},
    (localUnitImage (R := R) (K := K) (v : HeightOneSpectrum R)).range

/-- Explicit native character condition: local unramifiedness outside bad. -/
def UnramifiedOutside (χ : NumberField.HeckeCharacter R K)
    (bad : Set (HeightOneSpectrum R)) : Prop :=
  ∀ v : HeightOneSpectrum R, v ∉ bad → χ.IsUnramifiedAt v

/-- This kernel containment is the exact global condition for a
native Hecke character to factor through the outside-units quotient. -/
theorem unramifiedOutside_iff_global_kernel
    (χ : NumberField.HeckeCharacter R K)
    (bad : Set (HeightOneSpectrum R)) :
    UnramifiedOutside χ bad ↔
      outsideUnitSubgroup (R := R) (K := K) bad ≤
        χ.toMonoidHom.toHomUnits.ker := by
  rw [UnramifiedOutside, outsideUnitSubgroup, iSup_le_iff]
  constructor
  · intro h v
    exact (isUnramifiedAt_iff_range_le_ker χ v).mp (h v v.property)
  · intro h v hv
    exact (isUnramifiedAt_iff_range_le_ker χ v).mpr (h ⟨v, hv⟩)

/-- The normal closure of the generated good-place unit subgroup in the
native idèle class group. This makes the quotient group construction
independent of implicit normality instance search. -/
def outsideUnitNormalSubgroup
    (bad : Set (HeightOneSpectrum R)) :
    Subgroup (NumberField.IdeleClassGroup R K) :=
  Subgroup.normalClosure
    (outsideUnitSubgroup (R := R) (K := K) bad : Set (NumberField.IdeleClassGroup R K))

/-- Normality is proved by construction, not supplied as a mathematical hypothesis. -/
instance outsideUnitNormalSubgroup_normal
    (bad : Set (HeightOneSpectrum R)) :
    (outsideUnitNormalSubgroup (R := R) (K := K) bad).Normal :=
  Subgroup.normalClosure_normal

theorem unramifiedOutside_iff_global_normal_kernel
    (χ : NumberField.HeckeCharacter R K)
    (bad : Set (HeightOneSpectrum R)) :
    UnramifiedOutside χ bad ↔
      outsideUnitNormalSubgroup (R := R) (K := K) bad ≤
        χ.toMonoidHom.toHomUnits.ker := by
  constructor
  · intro h
    exact Subgroup.normalClosure_le_normal
      ((unramifiedOutside_iff_global_kernel χ bad).mp h)
  · intro h
    have hs : outsideUnitSubgroup (R := R) (K := K) bad ≤
        outsideUnitNormalSubgroup (R := R) (K := K) bad :=
      Subgroup.le_normalClosure
    exact (unramifiedOutside_iff_global_kernel χ bad).mpr (hs.trans h)

/-- Global quotient of the native idèle class group by local units
outside the bad set. A necessary *intermediate* quotient, not a complete
classical ray-class group. -/
abbrev OutsideUnitQuotient (bad : Set (HeightOneSpectrum R)) :=
  NumberField.IdeleClassGroup R K ⧸
    outsideUnitNormalSubgroup (R := R) (K := K) bad

/-- Canonical global quotient homomorphism. -/
def outsideUnitProjection (bad : Set (HeightOneSpectrum R)) :
    NumberField.IdeleClassGroup R K →*
      OutsideUnitQuotient (R := R) (K := K) bad :=
  QuotientGroup.mk' (outsideUnitNormalSubgroup (R := R) (K := K) bad)

/-- The exact kernel of the global projection is the normal closure of the
good-place local-unit subgroup, not a freely postulated ray kernel. -/
theorem outsideUnitProjection_ker (bad : Set (HeightOneSpectrum R)) :
    (outsideUnitProjection bad).ker =
      outsideUnitNormalSubgroup (R := R) (K := K) bad := by
  exact QuotientGroup.ker_mk' _

/-- An unramified-outside native idèle Hecke character descends
algebraically to the global quotient as a homomorphism to ℂˣ. -/
def descendToOutsideUnitQuotient
    (χ : NumberField.HeckeCharacter R K)
    (bad : Set (HeightOneSpectrum R))
    (h : UnramifiedOutside χ bad) :
    OutsideUnitQuotient (R := R) (K := K) bad →* ℂˣ :=
  QuotientGroup.lift (outsideUnitNormalSubgroup (R := R) (K := K) bad)
    χ.toMonoidHom.toHomUnits
    ((unramifiedOutside_iff_global_normal_kernel χ bad).mp h)

/-- A descended character recovers the original at every global
idèle class: no coefficients and no local values are changed. -/
theorem descendToOutsideUnitQuotient_comp
    (χ : NumberField.HeckeCharacter R K)
    (bad : Set (HeightOneSpectrum R))
    (h : UnramifiedOutside χ bad) :
    (descendToOutsideUnitQuotient χ bad h).comp
        (outsideUnitProjection bad) =
      χ.toMonoidHom.toHomUnits := by
  exact QuotientGroup.lift_comp_mk' _ _ _


/-! ## Finite-conductor congruence level and archimedean kernel

Unlike the previous outside-prime quotient, the following uses a finite-support
conductor exponent e(v). At each finite place it retains exactly those local
integer units which reduce to 1 modulo the e(v)-th power of the local maximal
ideal. It also kills every archimedean unit image. The algebraic subgroup
generated by the local images is then normal-closed, providing an explicit
global *ray-kernel candidate*, but no claim of topological closure or
identification with the classical ideal ray class group.
-/

/-- The depth-n principal congruence group of finite-place integer units.
At exponent zero the quotient ideal is the unit ideal; thus no restriction
on the unit is imposed. Positive exponents impose congruence to 1. -/
def localPrincipalUnits (v : HeightOneSpectrum R) (n : ℕ) :
    Subgroup (v.adicCompletionIntegers K)ˣ :=
  (Units.map
    (Ideal.Quotient.mk
      ((IsLocalRing.maximalIdeal (v.adicCompletionIntegers K)) ^ n)).toMonoidHom).ker

/-- True native idèle-class image of the principal local unit congruence
subgroup at a finite conductor depth. -/
def principalUnitImage
    (depth : HeightOneSpectrum R →₀ ℕ) (v : HeightOneSpectrum R) :
    (localPrincipalUnits (R := R) (K := K) v (depth v)) →*
      NumberField.IdeleClassGroup R K :=
  (localUnitImage (R := R) (K := K) v).comp
    (localPrincipalUnits (R := R) (K := K) v (depth v)).subtype

/-- Globally generated finite congruence-level idèle class subgroup. -/
def finiteLevelUnitSubgroup
    (depth : HeightOneSpectrum R →₀ ℕ) :
    Subgroup (NumberField.IdeleClassGroup R K) :=
  ⨆ v : HeightOneSpectrum R, (principalUnitImage (R := R) (K := K) depth v).range

/-- Images of units of all infinite completions in the native idèle class
group, not a merely named archimedean placeholder. -/
def infinityUnitSubgroup : Subgroup (NumberField.IdeleClassGroup R K) :=
  ⨆ w : NumberField.InfinitePlace K,
    (NumberField.IdeleClassGroup.ofCompletion R K w).range

/-- The algebraically generated and normal-closed conductor-level idèle
subgroup. The *topological closure* of infinitely many local units remains
a distinct obligation; this is not yet a classical ray class kernel. -/
def rayLevelNormalSubgroup (depth : HeightOneSpectrum R →₀ ℕ) :
    Subgroup (NumberField.IdeleClassGroup R K) :=
  Subgroup.normalClosure
    (((finiteLevelUnitSubgroup (R := R) (K := K) depth ⊔
      infinityUnitSubgroup (R := R) (K := K)) :
      Subgroup (NumberField.IdeleClassGroup R K)) :
      Set (NumberField.IdeleClassGroup R K))

instance rayLevelNormalSubgroup_normal (depth : HeightOneSpectrum R →₀ ℕ) :
    (rayLevelNormalSubgroup (R := R) (K := K) depth).Normal :=
  Subgroup.normalClosure_normal

/-- Local principal-congruence kernel condition at every finite place,
together with the full archimedean triviality condition. -/
def RayLevelTrivial
    (χ : NumberField.HeckeCharacter R K)
    (depth : HeightOneSpectrum R →₀ ℕ) : Prop :=
  (∀ v : HeightOneSpectrum R,
    ∀ u : localPrincipalUnits (R := R) (K := K) v (depth v),
      χ.toMonoidHom.toHomUnits
        (principalUnitImage (R := R) (K := K) depth v u) = 1) ∧
  (∀ w : NumberField.InfinitePlace K, ∀ u : w.Completionˣ,
      χ.toMonoidHom.toHomUnits
        (NumberField.IdeleClassGroup.ofCompletion R K w u) = 1)

/-- Exact algebraic global conductor-level condition:
triviality on all local congruence and archimedean images if and only if
the explicitly generated normal ray-level candidate lies in the kernel. -/
theorem rayLevelTrivial_iff_global_kernel
    (χ : NumberField.HeckeCharacter R K)
    (depth : HeightOneSpectrum R →₀ ℕ) :
    RayLevelTrivial χ depth ↔
      rayLevelNormalSubgroup (R := R) (K := K) depth ≤
        χ.toMonoidHom.toHomUnits.ker := by
  constructor
  · rintro ⟨hfinite, hinfty⟩
    apply Subgroup.normalClosure_le_normal
    change (finiteLevelUnitSubgroup (R := R) (K := K) depth ⊔
      infinityUnitSubgroup (R := R) (K := K)) ≤ χ.toMonoidHom.toHomUnits.ker
    apply sup_le
    · change (⨆ v : HeightOneSpectrum R,
        (principalUnitImage (R := R) (K := K) depth v).range) ≤
          χ.toMonoidHom.toHomUnits.ker
      refine iSup_le fun v => ?_
      intro g hg
      obtain ⟨u, rfl⟩ := hg
      exact (MonoidHom.mem_ker).mpr (hfinite v u)
    · change (⨆ w : NumberField.InfinitePlace K,
        (NumberField.IdeleClassGroup.ofCompletion R K w).range) ≤
          χ.toMonoidHom.toHomUnits.ker
      refine iSup_le fun w => ?_
      intro g hg
      obtain ⟨u, rfl⟩ := hg
      exact (MonoidHom.mem_ker).mpr (hinfty w u)
  · intro h
    have hsub :
        finiteLevelUnitSubgroup (R := R) (K := K) depth ⊔
          infinityUnitSubgroup (R := R) (K := K) ≤
          rayLevelNormalSubgroup (R := R) (K := K) depth := by
      change (finiteLevelUnitSubgroup (R := R) (K := K) depth ⊔
          infinityUnitSubgroup (R := R) (K := K)) ≤
        Subgroup.normalClosure
          (((finiteLevelUnitSubgroup (R := R) (K := K) depth ⊔
            infinityUnitSubgroup (R := R) (K := K)) :
             Subgroup (NumberField.IdeleClassGroup R K)) :
             Set (NumberField.IdeleClassGroup R K))
      exact (Subgroup.le_normalClosure (H :=
        finiteLevelUnitSubgroup (R := R) (K := K) depth ⊔
          infinityUnitSubgroup (R := R) (K := K)))
    have hfinite : finiteLevelUnitSubgroup (R := R) (K := K) depth ≤
        χ.toMonoidHom.toHomUnits.ker := (le_sup_left.trans (hsub.trans h))
    have hinfty : infinityUnitSubgroup (R := R) (K := K) ≤
        χ.toMonoidHom.toHomUnits.ker := (le_sup_right.trans (hsub.trans h))
    constructor
    · intro v u
      apply (MonoidHom.mem_ker).mp
      apply hfinite
      exact (le_iSup (fun w : HeightOneSpectrum R =>
        (principalUnitImage (R := R) (K := K) depth w).range) v) ⟨u, rfl⟩
    · intro w u
      apply (MonoidHom.mem_ker).mp
      apply hinfty
      exact (le_iSup (fun z : NumberField.InfinitePlace K =>
        (NumberField.IdeleClassGroup.ofCompletion R K z).range) w) ⟨u, rfl⟩

/-- Conductor-level algebraic quotient of the native idèle class group. -/
abbrev RayLevelQuotient (depth : HeightOneSpectrum R →₀ ℕ) :=
  NumberField.IdeleClassGroup R K ⧸
    rayLevelNormalSubgroup (R := R) (K := K) depth

def rayLevelProjection (depth : HeightOneSpectrum R →₀ ℕ) :
    NumberField.IdeleClassGroup R K →*
      RayLevelQuotient (R := R) (K := K) depth :=
  QuotientGroup.mk' (rayLevelNormalSubgroup (R := R) (K := K) depth)

theorem rayLevelProjection_ker (depth : HeightOneSpectrum R →₀ ℕ) :
    (rayLevelProjection depth).ker =
      rayLevelNormalSubgroup (R := R) (K := K) depth := by
  exact QuotientGroup.ker_mk' _

/-- The full finite-conductor local congruence and infinity hypotheses
construct a global algebraically descended character on the quotient. -/
def descendToRayLevel
    (χ : NumberField.HeckeCharacter R K)
    (depth : HeightOneSpectrum R →₀ ℕ)
    (h : RayLevelTrivial χ depth) :
    RayLevelQuotient (R := R) (K := K) depth →* ℂˣ :=
  QuotientGroup.lift (rayLevelNormalSubgroup (R := R) (K := K) depth)
    χ.toMonoidHom.toHomUnits
    ((rayLevelTrivial_iff_global_kernel χ depth).mp h)

theorem descendToRayLevel_comp
    (χ : NumberField.HeckeCharacter R K)
    (depth : HeightOneSpectrum R →₀ ℕ)
    (h : RayLevelTrivial χ depth) :
    (descendToRayLevel χ depth h).comp (rayLevelProjection depth) =
      χ.toMonoidHom.toHomUnits := by
  exact QuotientGroup.lift_comp_mk' _ _ _



/-! ## Topological completion of the native finite-conductor idèle ray kernel

The native Hecke character is genuinely continuous. We prove its unit-valued
algebraic kernel is closed, so it contains the topological closure of any
subgroup it annihilates. The closed ray-level subgroup therefore gives an
exact quotient with continuous descended character, without equating that
quotient to a traditional ideal ray class group.
-/

/-- The kernel of the actual native *continuous* Hecke character, viewed
in the unit group of the complex numbers, is topologically closed. -/
theorem nativeCharacter_ker_isClosed
    (χ : NumberField.HeckeCharacter R K) :
    IsClosed (χ.toMonoidHom.toHomUnits.ker : Set (NumberField.IdeleClassGroup R K)) := by
  have hc : Continuous ((Units.coeHom ℂ).comp χ.toMonoidHom.toHomUnits) := by
    change Continuous (χ : NumberField.IdeleClassGroup R K → ℂ)
    exact χ.continuous
  have hu : Continuous (χ.toMonoidHom.toHomUnits :
      NumberField.IdeleClassGroup R K → ℂˣ) :=
    Continuous.of_coeHom_comp hc
  change IsClosed ((χ.toMonoidHom.toHomUnits :
      NumberField.IdeleClassGroup R K → ℂˣ) ⁻¹' ({1} : Set ℂˣ))
  exact isClosed_singleton.preimage hu

/-- The genuine topological closure of the previously established
finite-conductor algebraic subgroup, in the native idèle class topology. -/
def closedRayLevelNormalSubgroup
    (depth : HeightOneSpectrum R →₀ ℕ) :
    Subgroup (NumberField.IdeleClassGroup R K) :=
  (rayLevelNormalSubgroup (R := R) (K := K) depth).topologicalClosure

instance closedRayLevelNormalSubgroup_normal
    (depth : HeightOneSpectrum R →₀ ℕ) :
    (closedRayLevelNormalSubgroup (R := R) (K := K) depth).Normal :=
  Subgroup.is_normal_topologicalClosure _

theorem closedRayLevelNormalSubgroup_isClosed
    (depth : HeightOneSpectrum R →₀ ℕ) :
    IsClosed (closedRayLevelNormalSubgroup (R := R) (K := K) depth :
      Set (NumberField.IdeleClassGroup R K)) :=
  Subgroup.isClosed_topologicalClosure _

/-- Exactly the same local depth/infinity triviality condition characterizes
annihilation of the **closed** global conductor-level subgroup. This uses
continuity of the original native Hecke character, not an extra closed-kernel
hypothesis. -/
theorem rayLevelTrivial_iff_closed_global_kernel
    (χ : NumberField.HeckeCharacter R K)
    (depth : HeightOneSpectrum R →₀ ℕ) :
    RayLevelTrivial χ depth ↔
      closedRayLevelNormalSubgroup (R := R) (K := K) depth ≤
        χ.toMonoidHom.toHomUnits.ker := by
  constructor
  · intro h
    exact Subgroup.topologicalClosure_minimal
      (rayLevelNormalSubgroup (R := R) (K := K) depth)
      ((rayLevelTrivial_iff_global_kernel χ depth).mp h)
      (nativeCharacter_ker_isClosed χ)
  · intro h
    exact (rayLevelTrivial_iff_global_kernel χ depth).mpr
      ((Subgroup.le_topologicalClosure
        (rayLevelNormalSubgroup (R := R) (K := K) depth)).trans h)

/-- Native topologically closed conductor-level idèle quotient.
Its identification with the arithmetic ideal ray-class group remains open. -/
abbrev ClosedRayLevelQuotient (depth : HeightOneSpectrum R →₀ ℕ) :=
  NumberField.IdeleClassGroup R K ⧸
    closedRayLevelNormalSubgroup (R := R) (K := K) depth

def closedRayLevelProjection (depth : HeightOneSpectrum R →₀ ℕ) :
    NumberField.IdeleClassGroup R K →*
      ClosedRayLevelQuotient (R := R) (K := K) depth :=
  QuotientGroup.mk' (closedRayLevelNormalSubgroup (R := R) (K := K) depth)

theorem closedRayLevelProjection_ker
    (depth : HeightOneSpectrum R →₀ ℕ) :
    (closedRayLevelProjection depth).ker =
      closedRayLevelNormalSubgroup (R := R) (K := K) depth := by
  exact QuotientGroup.ker_mk' _

/-- The native character descends algebraically even after taking the
topological closure of the conductor-level kernel. -/
def descendToClosedRayLevel
    (χ : NumberField.HeckeCharacter R K)
    (depth : HeightOneSpectrum R →₀ ℕ)
    (h : RayLevelTrivial χ depth) :
    ClosedRayLevelQuotient (R := R) (K := K) depth →* ℂˣ :=
  QuotientGroup.lift (closedRayLevelNormalSubgroup (R := R) (K := K) depth)
    χ.toMonoidHom.toHomUnits
    ((rayLevelTrivial_iff_closed_global_kernel χ depth).mp h)

theorem descendToClosedRayLevel_comp
    (χ : NumberField.HeckeCharacter R K)
    (depth : HeightOneSpectrum R →₀ ℕ)
    (h : RayLevelTrivial χ depth) :
    (descendToClosedRayLevel χ depth h).comp
        (closedRayLevelProjection depth) =
      χ.toMonoidHom.toHomUnits := by
  exact QuotientGroup.lift_comp_mk' _ _ _

/-- The character descended to the native quotient by the *closed*
finite-conductor kernel is continuous for the genuine quotient topology.
This is stronger than algebraic descent and does not assume a ray-class
correspondence. -/
theorem descendToClosedRayLevel_continuous
    (χ : NumberField.HeckeCharacter R K)
    (depth : HeightOneSpectrum R →₀ ℕ)
    (h : RayLevelTrivial χ depth) :
    Continuous (descendToClosedRayLevel χ depth h :
      ClosedRayLevelQuotient (R := R) (K := K) depth → ℂˣ) := by
  have hc : Continuous ((Units.coeHom ℂ).comp χ.toMonoidHom.toHomUnits) := by
    change Continuous (χ : NumberField.IdeleClassGroup R K → ℂ)
    exact χ.continuous
  have hu : Continuous (χ.toMonoidHom.toHomUnits :
      NumberField.IdeleClassGroup R K → ℂˣ) :=
    Continuous.of_coeHom_comp hc
  apply (QuotientGroup.isQuotientMap_mk
    (closedRayLevelNormalSubgroup (R := R) (K := K) depth)).continuous_iff.mpr
  have heq := descendToClosedRayLevel_comp χ depth h
  convert hu using 1
  funext x
  exact DFunLike.congr_fun heq x



/-! ## Actual arithmetic map from finite idèles to nonzero fractional ideals

The multiplicative adic valuation of a uniformizer is exp(-1). The negative
logarithm therefore gives the *positive* prime exponent, which is essential
for the character orientation in the eventual ray comparison.
-/

open scoped nonZeroDivisors

/-- Prime exponent of a genuine finite idèle, with the standard positive
uniformizer convention. -/
def finiteIdelePrimeExponent
    (a : (FiniteAdeleRing R K)ˣ) (v : HeightOneSpectrum R) : ℤ :=
  - WithZero.log (Valued.v (a.val v))

theorem finiteIdelePrimeExponent_eventually_zero
    (a : (FiniteAdeleRing R K)ˣ) :
    ∀ᶠ v : HeightOneSpectrum R in Filter.cofinite,
      finiteIdelePrimeExponent a v = 0 := by
  filter_upwards [FiniteAdeleRing.unitsEquiv_finite_valued_eq_one a] with v hv
  change - WithZero.log (Valued.v (a.val v)) = 0
  change Valued.v (a.val v) = 1 at hv
  rw [hv, WithZero.log_one, neg_zero]

/-- The actual fractional ideal associated to a finite idèle, as a finite
product of powers of the actual height-one prime ideals. -/
def finiteIdeleFractionalIdeal (a : (FiniteAdeleRing R K)ˣ) :
    FractionalIdeal R⁰ K :=
  ∏ᶠ v : HeightOneSpectrum R,
    (v.asIdeal : FractionalIdeal R⁰ K) ^ finiteIdelePrimeExponent a v

theorem finiteIdeleFractionalIdeal_ne_zero (a : (FiniteAdeleRing R K)ˣ) :
    finiteIdeleFractionalIdeal a ≠ 0 := by
  unfold finiteIdeleFractionalIdeal
  exact finprod_ne_zero fun v =>
    zpow_ne_zero _ (FractionalIdeal.coeIdeal_ne_zero.mpr v.ne_bot)

/-- Every ideal exponent is recovered exactly, with no inverse convention. -/
theorem finiteIdeleFractionalIdeal_count
    (a : (FiniteAdeleRing R K)ˣ) (v : HeightOneSpectrum R) :
    FractionalIdeal.count K v (finiteIdeleFractionalIdeal a) =
      finiteIdelePrimeExponent a v := by
  unfold finiteIdeleFractionalIdeal
  exact FractionalIdeal.count_finprod K v _
    (finiteIdelePrimeExponent_eventually_zero a)

/-- Explicit orientation at any place whose coordinate has uniformizer
valuation. This is the positive exponent of the corresponding prime. -/
theorem finiteIdeleFractionalIdeal_uniformizer_count
    (a : (FiniteAdeleRing R K)ˣ) (v : HeightOneSpectrum R)
    (h : Valued.v (a.val v) = WithZero.exp (-1)) :
    FractionalIdeal.count K v (finiteIdeleFractionalIdeal a) = 1 := by
  rw [finiteIdeleFractionalIdeal_count]
  simp [finiteIdelePrimeExponent, h]

/-- The arithmetic kernel is precisely the finite idèles whose prime
exponents are all zero. -/
theorem finiteIdeleFractionalIdeal_eq_one_iff
    (a : (FiniteAdeleRing R K)ˣ) :
    finiteIdeleFractionalIdeal a = 1 ↔
      ∀ v : HeightOneSpectrum R, finiteIdelePrimeExponent a v = 0 := by
  constructor
  · intro h v
    rw [← finiteIdeleFractionalIdeal_count a v, h, FractionalIdeal.count_one]
  · intro h
    unfold finiteIdeleFractionalIdeal
    simp [h]

/-- The native prime exponent is compatible with the multiplicative
valuation on a nonzero integral diagonal element. -/
theorem finiteIdeleFractionalIdeal_integral_count
    (r : R) (hr : r ≠ 0)
    (a : (FiniteAdeleRing R K)ˣ)
    (hdiag : ∀ v : HeightOneSpectrum R,
      a.val v = algebraMap R (v.adicCompletion K) r)
    (v : HeightOneSpectrum R) :
    FractionalIdeal.count K v (finiteIdeleFractionalIdeal a) =
      FractionalIdeal.count K v (Ideal.span {r} : Ideal R) := by
  rw [finiteIdeleFractionalIdeal_count, finiteIdelePrimeExponent, hdiag v]
  rw [v.valuedAdicCompletion_eq_valuation, v.valuation_of_algebraMap,
    v.intValuation_if_neg hr]
  rw [WithZero.log_exp, neg_neg, FractionalIdeal.count_coeIdeal]
  exact (Ideal.span_singleton_eq_bot.not.mpr hr)


end

